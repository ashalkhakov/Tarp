digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<left <= right>\l" ];
      n2 -> n4;
      n2 -> n3;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<n3>\l" ];
      n3 -> n12;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<n4>\l0:	var mid = left + (right - left) / 2;\l" ];
      n4 -> n5;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<arr[mid] == key>\l" ];
      n5 -> n7;
      n5 -> n8;
    n6 [ shape = "box"
             fontname = "Monospace"
             label = "<n6>\l" ];
      n6 -> n2;
    n7 [ shape = "box"
             fontname = "Monospace"
             label = "<n7>\l0:	return mid;\l" ];
      n7 -> n1;
    n8 [ shape = "box"
             fontname = "Monospace"
             label = "<arr[mid] < key>\l" ];
      n8 -> n10;
      n8 -> n11;
    n9 [ shape = "box"
             fontname = "Monospace"
             label = "<n9>\l" ];
      n9 -> n6;
    n10 [ shape = "box"
             fontname = "Monospace"
             label = "<n10>\l0:	left = mid + 1;\l" ];
      n10 -> n9;
    n11 [ shape = "box"
             fontname = "Monospace"
             label = "<n11>\l0:	right = mid - 1;\l" ];
      n11 -> n9;
    n12 [ shape = "box"
             fontname = "Monospace"
             label = "<n12>\l0:	return -1;\l" ];
      n12 -> n1;
}
