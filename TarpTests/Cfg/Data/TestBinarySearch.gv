digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<left <= right>\l" ];
      n2 -> n4;
      n2 -> n3;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<n3>\l0:	return -1;\l" ];
      n3 -> n1;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<arr[mid] == key>\l0:	var mid = left + (right - left) / 2;\l" ];
      n4 -> n6;
      n4 -> n7;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<n5>\l" ];
      n5 -> n2;
    n6 [ shape = "box"
             fontname = "Monospace"
             label = "<n6>\l0:	return mid;\l" ];
      n6 -> n1;
    n7 [ shape = "box"
             fontname = "Monospace"
             label = "<arr[mid] < key>\l" ];
      n7 -> n9;
      n7 -> n10;
    n8 [ shape = "box"
             fontname = "Monospace"
             label = "<n8>\l" ];
      n8 -> n5;
    n9 [ shape = "box"
             fontname = "Monospace"
             label = "<n9>\l0:	left = mid + 1;\l" ];
      n9 -> n8;
    n10 [ shape = "box"
             fontname = "Monospace"
             label = "<n10>\l0:	right = mid - 1;\l" ];
      n10 -> n8;
}
