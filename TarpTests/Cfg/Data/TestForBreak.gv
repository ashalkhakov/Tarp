digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<n2>\l0:	int r;\l" ];
      n2 -> n3;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<n3>\l0:	r = 1\l" ];
      n3 -> n4;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<n4>\l" ];
      n4 -> n7;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<n5>\l" ];
      n5 -> n11;
    n6 [ shape = "box"
             fontname = "Monospace"
             label = "<n6>\l0:	c--\l" ];
      n6 -> n4;
    n7 [ shape = "box"
             fontname = "Monospace"
             label = "<c <= 0>\l" ];
      n7 -> n9;
      n7 -> n8;
    n8 [ shape = "box"
             fontname = "Monospace"
             label = "<n8>\l" ];
      n8 -> n10;
    n9 [ shape = "box"
             fontname = "Monospace"
             label = "<n9>\l" ];
      n9 -> n5;
    n10 [ shape = "box"
             fontname = "Monospace"
             label = "<n10>\l0:	r *= c;\l" ];
      n10 -> n6;
    n11 [ shape = "box"
             fontname = "Monospace"
             label = "<n11>\l0:	return r;\l" ];
      n11 -> n1;
}
