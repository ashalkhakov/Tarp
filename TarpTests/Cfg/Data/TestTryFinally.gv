digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<n2>\l0:	busy = true;\l" ];
      n2 -> n3;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<try(n3)>\l0:	x++;\l" ];
      n3 -> n5;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<n4>\l" ];
      n4 -> n1;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<finally(n5)>\l0:	busy = false;\l" ];
      n5 -> n4;
}
