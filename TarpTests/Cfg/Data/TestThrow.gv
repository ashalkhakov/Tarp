digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n4;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<n2>\l0:	return 2 * x;\l" ];
      n2 -> n1;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<n3>\l" ];
      n3 -> n5;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<x <= 0>\l" ];
      n4 -> n3;
      n4 -> n2;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<n5>\l" ];
      n5 -> n1;
}
