digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<n2>\l0:	int r;\l" ];
      n2 -> n3;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<a > 0>\l" ];
      n3 -> n5;
      n3 -> n6;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<n4>\l" ];
      n4 -> n10;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<n5>\l0:	r = 1;\l" ];
      n5 -> n4;
    n6 [ shape = "box"
             fontname = "Monospace"
             label = "<a < 0>\l" ];
      n6 -> n8;
      n6 -> n9;
    n7 [ shape = "box"
             fontname = "Monospace"
             label = "<n7>\l" ];
      n7 -> n4;
    n8 [ shape = "box"
             fontname = "Monospace"
             label = "<n8>\l0:	r = -1;\l" ];
      n8 -> n7;
    n9 [ shape = "box"
             fontname = "Monospace"
             label = "<n9>\l0:	r = 0;\l" ];
      n9 -> n7;
    n10 [ shape = "box"
             fontname = "Monospace"
             label = "<n10>\l0:	return r;\l" ];
      n10 -> n1;
}
