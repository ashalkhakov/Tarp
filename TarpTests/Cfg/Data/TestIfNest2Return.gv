digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<a > 0>\l" ];
      n2 -> n4;
      n2 -> n3;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<n3>\l" ];
      n3 -> n8;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<b > 0>\l" ];
      n4 -> n6;
      n4 -> n7;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<n5>\l" ];
      n5 -> n3;
    n6 [ shape = "box"
             fontname = "Monospace"
             label = "<n6>\l0:	return 3;\l" ];
      n6 -> n1;
    n7 [ shape = "box"
             fontname = "Monospace"
             label = "<n7>\l0:	return 2;\l" ];
      n7 -> n1;
    n8 [ shape = "box"
             fontname = "Monospace"
             label = "<n8>\l0:	return 0;\l" ];
      n8 -> n1;
}
