digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n3;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<end>\l0:	Console.WriteLine(\"{0} located at {1}, {2}\", x, i, j);\l" ];
      n2 -> n1;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<n3>\l0:	int i, j;\l1:	i = 0\l" ];
      n3 -> n4;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<i < matrix.GetLength(0)>\l" ];
      n4 -> n6;
      n4 -> n5;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<n5>\l0:	Console.WriteLine(\"{0} not found\", x);\l1:	return;\l" ];
      n5 -> n1;
    n6 [ shape = "box"
             fontname = "Monospace"
             label = "<n6>\l0:	j = 0\l" ];
      n6 -> n8;
    n7 [ shape = "box"
             fontname = "Monospace"
             label = "<n7>\l0:	i++\l" ];
      n7 -> n4;
    n8 [ shape = "box"
             fontname = "Monospace"
             label = "<j < matrix.GetLength(1)>\l" ];
      n8 -> n9;
      n8 -> n7;
    n9 [ shape = "box"
             fontname = "Monospace"
             label = "<matrix[i,j] == x>\l" ];
      n9 -> n12;
      n9 -> n11;
    n10 [ shape = "box"
             fontname = "Monospace"
             label = "<n10>\l0:	j++\l" ];
      n10 -> n8;
    n11 [ shape = "box"
             fontname = "Monospace"
             label = "<n11>\l" ];
      n11 -> n10;
    n12 [ shape = "box"
             fontname = "Monospace"
             label = "<n12>\l" ];
      n12 -> n13;
    n13 [ shape = "box"
             fontname = "Monospace"
             label = "<n13>\l" ];
      n13 -> n2;
}
