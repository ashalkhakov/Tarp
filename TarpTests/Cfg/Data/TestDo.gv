digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<n2>\l0:	int r = 1;\l" ];
      n2 -> n4;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<n3>\l0:	return r;\l" ];
      n3 -> n1;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<n4>\l0:	r *= c;\l1:	c--;\l" ];
      n4 -> n5;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<c > 0>\l" ];
      n5 -> n4;
      n5 -> n3;
}
