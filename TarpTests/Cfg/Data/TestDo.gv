digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<n2>\l0:	int r = 1;\l" ];
      n2 -> n5;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<n3>\l" ];
      n3 -> n7;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<c > 0>\l" ];
      n4 -> n5;
      n4 -> n3;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<n5>\l0:	r *= c;\l" ];
      n5 -> n6;
    n6 [ shape = "box"
             fontname = "Monospace"
             label = "<n6>\l0:	c--;\l" ];
      n6 -> n4;
    n7 [ shape = "box"
             fontname = "Monospace"
             label = "<n7>\l0:	return r;\l" ];
      n7 -> n1;
}
