digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<n2>\l0:	int rows = matrix.GetLength(0);\l" ];
      n2 -> n3;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<n3>\l0:	int cols = matrix.GetLength(1);\l" ];
      n3 -> n4;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<n4>\l0:	int i = 0;\l" ];
      n4 -> n5;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<i < rows>\l" ];
      n5 -> n7;
      n5 -> n6;
    n6 [ shape = "box"
             fontname = "Monospace"
             label = "<n6>\l" ];
      n6 -> n1;
    n7 [ shape = "box"
             fontname = "Monospace"
             label = "<n7>\l0:	int j = 0;\l" ];
      n7 -> n8;
    n8 [ shape = "box"
             fontname = "Monospace"
             label = "<j < cols>\l" ];
      n8 -> n10;
      n8 -> n9;
    n9 [ shape = "box"
             fontname = "Monospace"
             label = "<n9>\l" ];
      n9 -> n12;
    n10 [ shape = "box"
             fontname = "Monospace"
             label = "<n10>\l0:	Console.Write(\"{0}\t\", matrix[i, j]);\l" ];
      n10 -> n11;
    n11 [ shape = "box"
             fontname = "Monospace"
             label = "<n11>\l0:	j++;\l" ];
      n11 -> n8;
    n12 [ shape = "box"
             fontname = "Monospace"
             label = "<n12>\l0:	Console.WriteLine();\l" ];
      n12 -> n13;
    n13 [ shape = "box"
             fontname = "Monospace"
             label = "<n13>\l0:	i++;\l" ];
      n13 -> n5;
}
