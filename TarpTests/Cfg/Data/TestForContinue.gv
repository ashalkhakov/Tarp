digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<n2>\l0:	int r;\l1:	r = 1\l" ];
      n2 -> n3;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<n3>\l" ];
      n3 -> n5;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<n4>\l0:	return r;\l" ];
      n4 -> n1;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<c > 0>\l" ];
      n5 -> n8;
      n5 -> n7;
    n6 [ shape = "box"
             fontname = "Monospace"
             label = "<n6>\l0:	c--\l" ];
      n6 -> n3;
    n7 [ shape = "box"
             fontname = "Monospace"
             label = "<n7>\l" ];
      n7 -> n10;
    n8 [ shape = "box"
             fontname = "Monospace"
             label = "<n8>\l0:	r *= c;\l" ];
      n8 -> n9;
    n9 [ shape = "box"
             fontname = "Monospace"
             label = "<n9>\l" ];
      n9 -> n6;
    n10 [ shape = "box"
             fontname = "Monospace"
             label = "<n10>\l" ];
      n10 -> n4;
}
