digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n3;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<Lstart>\l0:	Console.WriteLine(c);\l1:	c++;\l" ];
      n2 -> n6;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<n3>\l0:	int c = 0;\l" ];
      n3 -> n2;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<n4>\l" ];
      n4 -> n1;
    n5 [ shape = "box"
             fontname = "Monospace"
