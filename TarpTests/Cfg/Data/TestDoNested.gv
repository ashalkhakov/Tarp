digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<n2>\l0:	int i, j;\l" ];
      n2 -> n3;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<n3>\l0:	i = 1;\l" ];
      n3 -> n6;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<n4>\l" ];
      n4 -> n12;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<i <= 2>\l" ];
      n5 -> n6;
      n5 -> n4;
    n6 [ shape = "box"
             fontname = "Monospace"
             label = "<n6>\l0:	j = 1;\l" ];
      n6 -> n9;
    n7 [ shape = "box"
             fontname = "Monospace"
             label = "<n7>\l" ];
      n7 -> n11;
    n8 [ shape = "box"
             fontname = "Monospace"
             label = "<j <= 3>\l" ];
      n8 -> n9;
      n8 -> n7;
    n9 [ shape = "box"
             fontname = "Monospace"
             label = "<n9>\l0:	Console.WriteLine(\"i = {0}, j = {1}\", i, j);\l" ];
      n9 -> n10;
    n10 [ shape = "box"
             fontname = "Monospace"
             label = "<n10>\l0:	j++;\l" ];
      n10 -> n8;
    n11 [ shape = "box"
             fontname = "Monospace"
             label = "<n11>\l0:	i++;\l" ];
      n11 -> n5;
    n12 [ shape = "box"
             fontname = "Monospace"
             label = "<n12>\l0:	return 0;\l" ];
      n12 -> n1;
}
