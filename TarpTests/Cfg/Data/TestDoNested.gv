digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<n2>\l0:	int i, j;\l1:	i = 1;\l" ];
      n2 -> n4;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<n3>\l0:	return 0;\l" ];
      n3 -> n1;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<n4>\l0:	j = 1;\l" ];
      n4 -> n7;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<i <= 2>\l" ];
      n5 -> n4;
      n5 -> n3;
    n6 [ shape = "box"
             fontname = "Monospace"
             label = "<n6>\l0:	i++;\l" ];
      n6 -> n5;
    n7 [ shape = "box"
             fontname = "Monospace"
             label = "<n7>\l0:	Console.WriteLine(\"i = {0}, j = {1}\", i, j);\l1:	j++;\l" ];
      n7 -> n8;
    n8 [ shape = "box"
             fontname = "Monospace"
             label = "<j <= 3>\l" ];
      n8 -> n7;
      n8 -> n6;
}
