digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<n2>\l0:	var i = 0;\l" ];
      n2 -> n3;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<true>\l" ];
      n3 -> n5;
      n3 -> n4;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<n4>\l" ];
      n4 -> n1;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<i > a>\l" ];
      n5 -> n7;
      n5 -> n6;
    n6 [ shape = "box"
             fontname = "Monospace"
             label = "<n6>\l0:	i++;\l" ];
      n6 -> n3;
    n7 [ shape = "box"
             fontname = "Monospace"
             label = "<n7>\l" ];
      n7 -> n8;
    n8 [ shape = "box"
             fontname = "Monospace"
             label = "<n8>\l" ];
      n8 -> n4;
}
