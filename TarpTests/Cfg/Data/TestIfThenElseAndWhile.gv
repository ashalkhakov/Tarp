digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n2;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<x && !y>\l0:	bool x = true;\l1:	bool y = false;\l" ];
      n2 -> n4;
      n2 -> n5;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<x>\l" ];
      n3 -> n7;
      n3 -> n6;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<n4>\l0:	Console.WriteLine(\"Decision made\");\l" ];
      n4 -> n3;
    n5 [ shape = "box"
             fontname = "Monospace"
             label = "<n5>\l0:	Console.WriteLine(\"Alternative decision\");\l" ];
      n5 -> n3;
    n6 [ shape = "box"
             fontname = "Monospace"
             label = "<n6>\l" ];
      n6 -> n1;
    n7 [ shape = "box"
             fontname = "Monospace"
             label = "<n7>\l0:	Console.WriteLine(\"Looping\");\l1:	x = false;\l" ];
      n7 -> n3;
}
