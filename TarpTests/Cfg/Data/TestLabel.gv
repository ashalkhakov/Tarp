digraph G
{
    n0 [ shape = "box"
             fontname = "Monospace"
             label = "<entry>\l" ];
      n0 -> n4;
    n1 [ shape = "box"
             fontname = "Monospace"
             label = "<exit>\l" ];
    n2 [ shape = "box"
             fontname = "Monospace"
             label = "<lab1>\l" ];
      n2 -> n3;
    n3 [ shape = "box"
             fontname = "Monospace"
             label = "<lab2>\l0:	r += 3;\l1:	return r;\l" ];
      n3 -> n1;
    n4 [ shape = "box"
             fontname = "Monospace"
             label = "<n4>\l0:	int r;\l1:	r = 1;\l2:	r++;\l3:	r *= 2;\l" ];
      n4 -> n2;
}
